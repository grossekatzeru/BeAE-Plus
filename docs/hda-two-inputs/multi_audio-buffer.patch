+/*!	Size in bytes of one buffer of the given (recording) output: one device
+	buffer (return_record_buffer_size frames) of the output's own channels.
+*/
+size_t
+MultiAudioNode::_OutputBufferSize(const node_output& output) const
+{
+	return fDevice->BufferList().return_record_buffer_size
+		* (fInputPreferredFormat.u.raw_audio.format
+			& media_raw_audio_format::B_AUDIO_SIZE_MASK)
+		* output.fPreferredFormat.u.raw_audio.channel_count;
+}
+
+
+void
+MultiAudioNode::_UpdateOutputBufferSize(node_output& output)
+{
+	const size_t size = _OutputBufferSize(output);
+	output.fPreferredFormat.u.raw_audio.buffer_size = size;
+	output.fOutput.format.u.raw_audio.buffer_size = size;
+}
